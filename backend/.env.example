# ─── Base de données (Supabase) ──────────────────────────────────────────────
# URL pooler (PgBouncer) pour les requêtes normales
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# URL directe pour les migrations Prisma
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="remplacer-par-un-secret-aleatoire-minimum-48-caracteres"

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="production"

# URL du frontend (utilisée dans les liens email : vérification, reset, etc.)
# En dev : http://localhost:5173
# En prod : votre domaine Vercel ou etutorat.sn
FRONTEND_URL="https://votre-frontend.vercel.app"

# ─── Emails (Nodemailer via Gmail) ────────────────────────────────────────────
# ÉTAPES DE CONFIGURATION :
# 1. Activer la validation en 2 étapes sur votre compte Gmail
# 2. Aller sur : https://myaccount.google.com/apppasswords
# 3. Sélectionner "Autre" > nommer "e-Tutorat" > Générer
# 4. Coller le mot de passe de 16 caractères dans EMAIL_PASS
#
# Alternative : utiliser SendGrid ou Resend (meilleure délivrabilité en prod)
#   → Remplacer le sender.js avec leur SDK
EMAIL_USER="votre-email@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
