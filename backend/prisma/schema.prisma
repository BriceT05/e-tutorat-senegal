generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ELEVE
  TUTEUR
  ADMIN
}

enum RequestStatus {
  EN_ATTENTE
  CONFIRMEE
  REFUSEE
}

model User {
  id        String   @id @default(uuid())
  prenom    String
  nom       String
  email     String   @unique
  password  String
  role      Role
  photo     String?
  tel       String?
  whatsapp  String?
  region    String?
  createdAt DateTime @default(now())

  // Champs élève
  niveau    String?
  typeCours String?
  budget    String?

  // Champs tuteur
  bio           String?
  diplome       String?
  tarif         Int?
  modeCours     String?
  noteAvg       Float?   @default(0)
  nbAvis        Int?     @default(0)
  experience    String?
  methodologie  String?
  disponibilites Json?
  tauxReponse   Int?
  delaiReponse  String?
  totalEleves   Int?     @default(0)

  // Tableaux tuteur supplémentaires
  langues     String[]
  formations  String[]

  // Vérification email
  emailVerified    Boolean   @default(false)
  emailVerifyToken String?

  // Réinitialisation mot de passe
  resetToken       String?
  resetTokenExpiry DateTime?

  // Relations tableaux (stockés en JSON)
  matieres  String[]
  niveaux   String[]

  requestsAsEleve  TutoringRequest[] @relation("Eleve")
  requestsAsTuteur TutoringRequest[] @relation("Tuteur")
  messagesSent     Message[]
  conversations    ConversationMember[]
  notifications    Notification[]

  @@map("users")
}

model TutoringRequest {
  id         String        @id @default(uuid())
  eleveId    String
  tuteurId   String
  eleve      User          @relation("Eleve", fields: [eleveId], references: [id])
  tuteur     User          @relation("Tuteur", fields: [tuteurId], references: [id])
  matiere    String
  niveau     String?
  jours      String[]
  duree      String?
  mode       String?
  message    String?
  tarif      Int?
  status     RequestStatus @default(EN_ATTENTE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("tutoring_requests")
}

model Conversation {
  id        String               @id @default(uuid())
  createdAt DateTime             @default(now())
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  userId         String
  conversationId String
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  unread         Int          @default(0)

  @@id([userId, conversationId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model LoginOtp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("login_otps")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  emoji     String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
